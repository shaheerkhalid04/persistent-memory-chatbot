# Copy to .env and fill in. The app picks the first provider with a key set,
# in the order Groq -> Gemini -> OpenAI, and runs in demo mode if none is found.

# --- LLM (pick one) ----------------------------------------------------------
GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Optional: pin a provider or override its default model.
# LLM_PROVIDER=groq
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_MODEL=gpt-4o-mini

# --- Memory ------------------------------------------------------------------
# sqlite (default, on disk) or mem0 (hosted platform, needs MEM0_API_KEY)
# MEMORY_BACKEND=sqlite
# MEM0_API_KEY=

# --- Storage -----------------------------------------------------------------
# RECALL_DB_PATH=data/recall.db
# USER_ID=local
# Give each browser session its own memory namespace. Leave off for normal
# single-user local use; turn on for a public deployment so visitors cannot
# see each other's conversations and facts.
# MULTI_USER=0
# MAX_MEMORIES_IN_CONTEXT=40
